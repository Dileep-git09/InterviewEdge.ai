# Copy this file to .env in the same folder and fill in real values.
# .env is gitignored — never commit real secrets.

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8000
# production | development — production hides stack traces in error responses
NODE_ENV=development

# ── MongoDB (Atlas) ───────────────────────────────────────────────────────
# Atlas → Database → Connect → Drivers → Node.js. Remember to also whitelist
# your deploy host's IP under Atlas → Network Access.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<cluster-name>

# ── Auth ───────────────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── AI providers ───────────────────────────────────────────────────────────
# Primary: Google AI Studio (free) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Fallback: Groq (free, no card) — https://console.groq.com
# Used automatically when Gemini hits a quota/rate-limit/outage error.
GROQ_API_KEY=

# ── Redis (Upstash) ─────────────────────────────────────────────────────────
# Optional but recommended — the app degrades gracefully without it (falls
# back to calling the AI directly / querying MongoDB, just slower/uncached).
# Upstash → your database → Connect → copy the rediss:// URL (note: two S's,
# TLS is required).
REDIS_URL=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins in production, e.g.
#   FRONTEND_URL=https://your-app.vercel.app,https://yourdomain.com
# Leave unset for local dev — all origins are allowed when this is empty.
FRONTEND_URL=

# ── Rate limiting (optional — sensible defaults apply if unset) ────────────
# AI endpoints: requests per user per window
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=900000
# Login/register: attempts per IP per 15-minute window (brute-force guard)
AUTH_RATE_LIMIT_MAX=10

# ── Email (forgot-password) ─────────────────────────────────────────────────
# Optional but needed for the forgot-password flow to actually deliver email —
# without these, reset links are logged to the server console instead (fine
# for local dev, not for production). Works with any SMTP provider: Gmail (an
# app password, not your real password), or the SMTP relay most transactional
# email services (SendGrid, Mailgun, Resend, etc.) provide.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Monitoring (optional) ───────────────────────────────────────────────────
# Free tier at sentry.io. Without this set, error monitoring is a no-op —
# nothing breaks, you just don't get alerted when something goes wrong.
SENTRY_DSN=
