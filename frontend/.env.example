# Copy this file to .env in the same folder and fill in real values.
# .env is gitignored — never commit real secrets.
# Vite only exposes vars prefixed VITE_, and bakes them in at BUILD time —
# set this in your hosting provider's build environment for production too,
# not just here.

# Base URL of the backend API. Falls back to http://localhost:8000 if unset,
# which is fine for local dev against a locally running backend.
VITE_API_BASE_URL=http://localhost:8000
